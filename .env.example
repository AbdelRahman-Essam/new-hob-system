# Copy this file to /etc/newhope.env on the server (not inside the project folder)
# and fill in real values. Never commit the real .env to git.

SECRET_KEY=replace-with-a-long-random-string
DEBUG=0
ALLOWED_HOSTS=yourname.duckdns.org
CSRF_TRUSTED_ORIGINS=https://yourname.duckdns.org
SECURE_SSL_REDIRECT=1
